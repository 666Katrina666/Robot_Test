    - target: {fileID: 8853410842431340804, guid: a26ee4c5806b1dd4abfa27ab0f0fdf1d, type: 3}
      propertyPath: m_text
      value: "\u0414\u043B\u044F \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
        \u0440\u043E\u0431\u043E\u0442\u043E\u043C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
        \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 \u043A\u043B\u0430\u0432\u0438\u0448\u0438:\n\nW
        \u2014 \u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0432\u043F\u0435\u0440\u0435\u0434.\nS
        \u2014 \u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u043D\u0430\u0437\u0430\u0434.\nA
        \u2014 \u041F\u043E\u0432\u043E\u0440\u043E\u0442 \u0440\u043E\u0431\u043E\u0442\u0430
        \u0432\u043B\u0435\u0432\u043E.\nD \u2014 \u041F\u043E\u0432\u043E\u0440\u043E\u0442
        \u0440\u043E\u0431\u043E\u0442\u0430 \u0432\u043F\u0440\u0430\u0432\u043E.\nR
        \u2014 \u0421\u043C\u0435\u043D\u0430 \u0440\u0435\u0436\u0438\u043C\u0430
        \u043A\u0430\u043C\u0435\u0440\u044B.\nSpace \u2014 \u0420\u0435\u0441\u0442\u0430\u0440\u0442
        \u0443\u0440\u043E\u0432\u043D\u044F."
      objectReference: {fileID: 0}
